{
  "name": "@riptide-labs/lcars",
  "version": "0.1.0",
  "description": "Modern, accessible LCARS Web Component library and design token system",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/lcars.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": "./dist/lcars.css",
    "./tokens": "./dist/lcars.css",
    "./iife": "./dist/lcars.iife.js"
  },
  "sideEffects": [
    "*.css",
    "./src/tokens/*.css",
    "./src/index.ts",
    "./dist/index.js",
    "./dist/lcars.iife.js"
  ],
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode iife",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "happy-dom": "^20.11.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^2.1.8"
  },
  "license": "LGPL-3.0-or-later",
  "author": "Ronny Trommer <ronny@no42.org>",
  "dependencies": {
    "lit": "^3.3.3"
  }
}
